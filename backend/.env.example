# Copy to .env (git-ignored) and fill in real values. Never commit .env.
#
# Phase 9 — AI-powered candidate explanation (DeepSeek V4 Flash via
# Featherless). Optional: if unset, the pipeline automatically uses the
# deterministic explanation provider instead — nothing else depends on this
# key. See docs/ai-explanation.md.
FEATHERLESS_API_KEY=your_key_here

# Optional overrides (sensible defaults are used if unset):
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# FEATHERLESS_TIMEOUT_SECONDS=30

# Copy to .env.local (git-ignored) to point at a non-default backend.
# This is just the backend's own URL — never a secret. The Featherless/
# DeepSeek API key lives ONLY server-side (backend/.env) and is never read,
# referenced, or bundled by this frontend.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
